      "name": "53. Удалить пустую категорию",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/categories/{{deleteCategoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "54. Создать читателя через CRUD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/readers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"CRUD\",\n  \"email\": \"crud{{run}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"crudReaderId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "55. Изменить читателя через CRUD",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/readers/{{crudReaderId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Обновлённый\",\n  \"email\": \"crud{{run}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "56. Удалить читателя без выдач",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/readers/{{crudReaderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
