{
  "info": {
    "name": "Лабораторная 4 — Spring Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Выполнить все запросы по порядку в Collection Runner с включёнными cookies. Каждая проверка содержит ожидаемый HTTP-код. При повторном запуске создаются новые тестовые данные."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{librarianEmail}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{librarianPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "librarianEmail",
      "value": "librarian@example.com"
    },
    {
      "key": "librarianPassword",
      "value": "Librarian123!"
    }
  ],
  "item": [
    {
      "name": "01. Получить CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);",
              "const run = Date.now();",
              "pm.collectionVariables.set(\"run\", run);",
              "pm.collectionVariables.set(\"readerEmail\", \"reader\" + run + \"@example.com\");",
              "pm.collectionVariables.set(\"otherEmail\", \"other\" + run + \"@example.com\");"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Регистрация без CSRF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Читатель\",\n  \"email\": \"{{readerEmail}}\",\n  \"password\": \"Reader123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
