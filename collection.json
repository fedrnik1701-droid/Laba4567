    {
      "name": "05. Регистрация без повышения прав",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Читатель\",\n  \"email\": \"{{readerEmail}}\",\n  \"password\": \"Reader123!\",\n  \"role\": \"LIBRARIAN\",\n  \"active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"readerId\", pm.response.json().id);",
              "pm.test(\"Только READER, пароль скрыт\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.role).to.eql(\"READER\");",
              "    pm.expect(data.active).to.eql(true);",
              "    pm.expect(data).not.to.have.property(\"password\");",
              "});"
            ]
          }
        }
      ]
    },
